# Copy to .env in THIS directory (next to docker-compose.yml), then adjust.
# NEVER commit real secrets — .env is gitignored.

# --- General ---
COMPOSE_PROJECT_NAME=ark
ARK_SERVER_VOLUME=ark-data

# --- Session / Map ---
SESSION_NAME=My ARK SE Server
SERVER_MAP=TheIsland
MAX_PLAYERS=2

# --- Secrets (must change) ---
# SERVER_PASSWORD is the join password: the ARK client only accepts letters + digits,
# max 24 characters (no special chars). ADMIN_PASSWORD is for RCON/admin, not entered on
# join, but keep it alphanumeric too to avoid shell/compose quoting issues.
SERVER_PASSWORD=change-me
ADMIN_PASSWORD=change-me-too

# --- Lifecycle ---
UPDATE_ON_START=true
BACKUP_ON_STOP=false
PRE_UPDATE_BACKUP=true
WARN_ON_STOP=true

# --- Launch flags ---
# BattlEye anti-cheat is ON by default. Set true to disable it (server launches with
# -NoBattlEye). Note: this is a launch flag, NOT a GameUserSettings.ini setting.
DISABLE_BATTLEYE=false
# Epic<->Steam crossplay (-crossplay).
ENABLE_CROSSPLAY=false
# In-game log (chat/player events) to Saved/Logs/ShooterGame*.log. OFF by default; set true
# to launch with -servergamelog. The log is pruned count-based via cron so it can't grow
# unbounded. Without this flag ShooterGame.log stays 0 B.
ENABLE_GAME_LOG=false

# --- Permissions / Resources ---
# PUID/PGID must match the host user owning the volume/bind mount; UMASK affects new files.
PUID=1000
PGID=1000
UMASK=0002
# RAM cap for the container (#85). Keep >=12g — ARK SE livelocks below ~10g even on
# TheIsland; raise for big maps/many mods. See ../arkserver-ops/server/docs/hardware-requirements.md.
MEM_LIMIT=12g

# --- Mods (optional, comma-separated Workshop IDs) ---
GAME_MOD_IDS=
# Workshop ID of a MAP mod (mod map instead of a stock map). Empty = stock map.
SERVER_MAP_MOD_ID=

# --- Cluster (opt-in) — leave empty for a plain vanilla server. ---
# See ../arkserver-ops/server/docs/mods-and-cluster.md for topologies and port offsets.
CLUSTER_ID=
SUB_INSTANCE_KEYS=

# --- Panel (optional) — only needed when starting with `--profile panel`. ---
# Admin login for the management panel (HTTP Basic Auth). LAN-only; remote via VPN.
PANEL_USER=admin
PANEL_PASS=change-me-panel
# Which host address the panel's port is published on. The default reaches only this machine, which
# is why the panel is safe to run without HTTPS. To open it to the local network, either name this
# machine's LAN address (e.g. PANEL_BIND=192.168.1.10), which reaches that network alone but drops
# localhost and breaks when DHCP changes the address, or use 0.0.0.0, which keeps localhost and
# survives that but publishes on every interface the host has. Basic Auth over plain HTTP sends the
# password base64-encoded, so a trusted network is the limit either way: never a public address,
# never a forwarded port, remote access via VPN.
PANEL_BIND=127.0.0.1
# This machine's IPv4 address in the local network (Windows: ipconfig, "IPv4 address"), for the
# panel's connect line. Other devices in the same household use it to join, no port forwarding
# involved. Leave empty if you always open the panel from another device anyway.
ARK_LAN_HOST=

# How the server is reached from outside: a public IP or a hostname, optionally with a port. Only
# used for the panel's connect line, which otherwise stays open for the outside case. Leave empty on
# a LAN-only setup.
ARK_PUBLIC_HOST=

# Panel version to run. The panel releases far more often than the server, so its pin lives here
# rather than in the compose file: a panel update is an edit next to `docker compose up -d`, not a
# change to this repo. Pinned, never `latest` — a recreate must not change what runs.
PANEL_VERSION=0.15.0
